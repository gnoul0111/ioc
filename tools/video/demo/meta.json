  {
   "a": 13.558958000000002,
   "b": 16.519458,
   "text": "Hệ thống Trung tâm điều hành thông minh – IOC"
  },
  {
   "a": 16.519458,
   "b": 18.861583,
   "text": "phục vụ công tác lãnh đạo, chỉ đạo"
  },
  {
   "a": 18.861583,
   "b": 20.889458,
   "text": "điều hành của Thành phố Hà Nội."
  },
  {
   "a": 24.250958,
   "b": 26.81675,
   "text": "Dữ liệu từ hệ thống nguồn của mười bốn sở"
  },
  {
   "a": 26.81675,
   "b": 29.724625,
   "text": "ba đơn vị ngang sở và một trăm hai mươi sáu xã"
  },
  {
   "a": 29.724625,
   "b": 32.910458000000006,
   "text": "phường được tiếp nhận, chuẩn hóa qua nền tảng dữ liệu."
  },
  {
   "a": 37.412958,
   "b": 40.14979100000001,
   "text": "Chỉ tiêu các sở, ngành được trình bày thống nhất"
  },
  {
   "a": 40.14979100000001,
   "b": 43.610333000000004,
   "text": "thẻ chỉ số, màu theo mức đạt, biểu đồ diễn biến"
  },
  {
   "a": 43.610333000000004,
   "b": 46.00662400000001,
   "text": "kèm nguồn dữ liệu và thời điểm cập nhật."
  }
